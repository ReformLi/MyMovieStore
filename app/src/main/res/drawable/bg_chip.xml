<?xml version="1.0" encoding="utf-8"?>
<!--
  搜索历史关键词标签（chip）的底色。
  原填色 #F0F0F0 贴在纯白卡片（#FFFFFF）上只差 15 级，看上去「泛白」；只加描边仍是一块发白的浅底。
  所以填充本身一步加深到明确的中灰（@color/chip_history_background：浅色 #CFCFCF / 深色 #333333），
  再配一圈 1dp 描边勾出轮廓。
  注：本 drawable 全项目仅搜索历史 chip 使用，不影响弹窗等处的 chip_background 取色。
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@color/chip_history_background" />
    <stroke
        android:width="1dp"
        android:color="@color/chip_history_stroke" />
    <corners android:radius="12dp" />
</shape>
