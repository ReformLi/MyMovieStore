<?xml version="1.0" encoding="utf-8"?>
<!-- 选择下载集数（**横屏 TV · 仪表盘风 · 分栏**）
     与视频源管理同构：左「全选胶囊 + 集数列表（独立行卡）+ 提示」，右「取消 / 确定」竖排按钮栏。

     ⚠️ 本弹框走 **ViewBinding**（DialogEpisodeSelectBinding）：竖屏 layout/dialog_episode_select.xml
        暴露的非空字段 tvSelectAll / tvSelectedCount / rvEpisodes / btnCancel / btnConfirm，
        **横屏版必须全部包含同名 id**，否则字段退化为可空、EpisodeSelectDialog.kt 里
        binding.rvEpisodes 等直接编译不过。装饰性视图不加 id。

     ⚠️ 焦点：行卡 focusable + nextFocusRight → 取消；已添加锁定项由代码置 isFocusable=false，
        焦点自动跳过。DialogSizing 以 split=true 放宽宽度（仅横屏生效，竖屏零回归）。 -->
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:cardBackgroundColor="@color/dialog_background"
    app:cardCornerRadius="24dp"
    app:cardElevation="0dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="26dp"
        android:paddingEnd="26dp"
        android:paddingTop="24dp"
        android:paddingBottom="24dp">

        <!-- ============ 头部：图标徽章 + 左对齐标题/副标题 ============ -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/bg_icon_chip"
                android:padding="9dp"
                android:src="@drawable/ic_download"
                app:tint="@color/colorPrimary" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/episode_select_title"
                    android:textColor="@color/colorOnSurface"
                    android:textSize="20sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:text="@string/episode_select_subtitle"
                    android:textColor="@color/colorOnSurfaceSecondary"
                    android:textSize="12sp" />
            </LinearLayout>
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="16dp"
            android:background="@color/divider" />

        <!-- ============ 主体：左选择区 + 右按钮栏 ============ -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:orientation="horizontal">

            <!-- ============ 左：选择区 ============ -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <!-- 工具行：全选/全不选（橙底胶囊） + 已选计数 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/tvSelectAll"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_icon_chip_ripple"
                        android:nextFocusRight="@id/btnCancel"
                        android:paddingStart="14dp"
                        android:paddingTop="12dp"
                        android:paddingEnd="14dp"
                        android:paddingBottom="12dp"
                        android:text="@string/select_all"
                        android:textColor="@color/colorPrimary"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:minHeight="48dp"
                        android:gravity="center"
                    />

                    <View
                        android:layout_width="0dp"
                        android:layout_height="1dp"
                        android:layout_weight="1" />

                    <TextView
                        android:id="@+id/tvSelectedCount"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/colorOnSurfaceSecondary"
                        android:textSize="12sp" />

                </LinearLayout>

                <!-- 集数列表（行卡见 layout-land/item_episode_select.xml） -->
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rvEpisodes"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:clipToPadding="false"
                    android:nextFocusRight="@id/btnCancel"
                    android:overScrollMode="never" />

                <!-- 提示 -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/episode_select_hint"
                    android:textColor="@color/colorOnSurfaceDisabled"
                    android:textSize="11sp" />

            </LinearLayout>

            <!-- ============ 右：按钮栏 ============ -->
            <LinearLayout
                android:layout_width="140dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="20dp"
                android:orientation="vertical">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnCancel"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:nextFocusDown="@id/btnConfirm"
                    android:text="@string/cancel"
                    android:textColor="@color/colorOnSurface"
                    app:backgroundTint="@android:color/transparent"
                    app:cornerRadius="12dp"
                    app:strokeColor="@color/colorOnSurfaceSecondary"
                    app:strokeWidth="1dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnConfirm"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="12dp"
                    android:nextFocusUp="@id/btnCancel"
                    android:backgroundTint="@color/colorPrimary"
                    android:text="@string/confirm_ok"
                    android:textColor="@color/colorOnPrimary"
                    android:textStyle="bold"
                    app:cornerRadius="12dp" />

            </LinearLayout>

        </LinearLayout>

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
