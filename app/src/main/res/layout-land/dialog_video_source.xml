<?xml version="1.0" encoding="utf-8"?>
<!-- 视频源管理（**横屏分栏版**）
     = 竖屏版 layout/dialog_video_source.xml 的横屏布局：
       左侧「全选/全不选 + 已选计数 + 源列表 + 提示」，右侧一列竖排按钮（取消 / 确定）。

     ⚠️ 两份布局的 id 必须**完全一致**：ViewBinding 取各限定符 id 的并集，
        少一个就会把对应字段退化成可空类型，Kotlin 侧全部要改 ?. 才能编译。

     ⚠️ 焦点左右导航：右侧按钮栏与左列同处一条水平带，靠 android:nextFocus* 显式声明
        「列表行 →（右键）→ 取消」；反方向（按钮 →左键→ 列表）交给系统的几何搜索，
        落点会自然停在 y 最接近的那一行，比写死 id 更符合直觉。 -->
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:cardBackgroundColor="@color/dialog_background"
    app:cardCornerRadius="24dp"
    app:cardElevation="0dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:paddingTop="22dp"
        android:paddingBottom="22dp">

        <!-- 标题 -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:text="@string/video_source"
            android:textColor="@color/colorOnSurface"
            android:textSize="19sp"
            android:textStyle="bold" />

        <!-- 副标题 -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="center"
            android:text="@string/video_source_subtitle"
            android:textColor="@color/colorOnSurfaceSecondary"
            android:textSize="13sp" />

        <!-- 主体：左选择区 + 右按钮栏 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:orientation="horizontal">

            <!-- ============ 左：选择区 ============ -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <!-- 操作行：全选/全不选 + 已选计数 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/tvSelectAll"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/ripple_clickable"
                        android:nextFocusRight="@id/btnCancel"
                        android:paddingStart="4dp"
                        android:paddingTop="4dp"
                        android:paddingEnd="4dp"
                        android:paddingBottom="4dp"
                        android:text="@string/select_all"
                        android:textColor="@color/colorPrimary"
                        android:textSize="14sp" />

                    <View
                        android:layout_width="0dp"
                        android:layout_height="1dp"
                        android:layout_weight="1" />

                    <TextView
                        android:id="@+id/tvSelectedCount"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/colorOnSurfaceSecondary"
                        android:textSize="12sp" />

                </LinearLayout>

                <!-- 视频源列表 -->
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rvSources"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:nextFocusRight="@id/btnCancel"
                    android:overScrollMode="never" />

                <!-- 提示 -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:gravity="center"
                    android:text="@string/video_source_hint"
                    android:textColor="@color/colorOnSurfaceDisabled"
                    android:textSize="11sp" />

            </LinearLayout>

            <!-- ============ 右：按钮栏 ============ -->
            <LinearLayout
                android:layout_width="132dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="18dp"
                android:orientation="vertical">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnCancel"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:text="@string/cancel"
                    android:backgroundTint="@color/chip_background"
                    android:textColor="@color/colorOnSurface"
                    app:cornerRadius="12dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnConfirm"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:layout_marginTop="10dp"
                    android:text="@string/confirm_ok"
                    android:backgroundTint="@color/colorPrimary"
                    android:textColor="@color/colorOnPrimary"
                    app:cornerRadius="12dp" />

            </LinearLayout>

        </LinearLayout>

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
