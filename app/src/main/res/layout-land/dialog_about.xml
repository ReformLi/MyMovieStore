<?xml version="1.0" encoding="utf-8"?>
<!-- 关于页（**横屏 TV · 仪表盘风**）

     头部 = ic_about 图标徽章 + 左对齐标题（副行 App 名），版本号徽章移到头部右侧；
     「检查更新」与「更新详情」两块内容升级为独立圆角行卡（bg_row_card 系），放进可滚动区。

     ⚠️ 本弹框用 findViewById（非 ViewBinding），**缺 id 是运行时 NPE 而非编译错误**：
        tvVersion / scrollContent / layoutCheckUpdate / tvUpdateTitle / tvUpdateStatus /
        progressCheck / layoutUpdateCard / tvNewVersion / tvUpdateDetails / progressDownload /
        tvDownloadProgress / btnUpdate / tvClose —— 与 AboutDialog.kt 声明的类型一一对应
        （scrollContent 必须是 ScrollView、layoutCheckUpdate/layoutUpdateCard 必须是 LinearLayout、
        btnUpdate/tvClose 是 MaterialButton，tvClose 在代码里按 TextView 接收，MaterialButton 兼容）。

     焦点：滚动区内是行卡与按钮（代码 applyToDialogButtons 遍历挂环）；
     正文本身无需滚动焦点（内容短于限高时不滚，长了由「检查更新」行的焦点移动带动）。 -->
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:cardBackgroundColor="@color/dialog_background"
    app:cardCornerRadius="24dp"
    app:cardElevation="0dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="26dp"
        android:paddingEnd="26dp"
        android:paddingTop="24dp"
        android:paddingBottom="24dp">

        <!-- ============ 头部：图标徽章 + 标题/App 名 + 版本徽章 ============ -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/bg_icon_chip"
                android:padding="9dp"
                android:src="@drawable/ic_about"
                app:tint="@color/colorPrimary" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/about"
                    android:textColor="@color/colorOnSurface"
                    android:textSize="20sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:text="@string/app_name"
                    android:textColor="@color/colorOnSurfaceSecondary"
                    android:textSize="12sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvVersion"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_icon_chip"
                android:paddingStart="12dp"
                android:paddingTop="6dp"
                android:paddingEnd="12dp"
                android:paddingBottom="6dp"
                android:textColor="@color/colorPrimary"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- 简介 -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:lineSpacingExtra="3dp"
            android:text="@string/about_description"
            android:textColor="@color/colorOnSurfaceSecondary"
            android:textSize="13sp" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="16dp"
            android:background="@color/divider" />

        <!-- ============ 内容区（更新信息，超长可滚动；DialogSizing 限高） ============ -->
        <ScrollView
            android:id="@+id/scrollContent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:focusable="false"
            android:overScrollMode="never"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <!-- ============ 检查更新（独立行卡，整行可点击） ============ -->
                <LinearLayout
                    android:id="@+id/layoutCheckUpdate"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_row_card_ripple"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="12dp"
                    android:paddingTop="12dp"
                    android:paddingEnd="14dp"
                    android:paddingBottom="12dp">

                    <ImageView
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:background="@drawable/bg_icon_chip"
                        android:padding="8dp"
                        android:src="@drawable/ic_player_settings"
                        app:tint="@color/colorPrimary" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/tvUpdateTitle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/check_update"
                            android:textColor="@color/colorOnSurface"
                            android:textSize="15sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tvUpdateStatus"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="@string/check_update_hint"
                            android:textColor="@color/colorOnSurfaceSecondary"
                            android:textSize="12sp" />
                    </LinearLayout>

                    <ProgressBar
                        android:id="@+id/progressCheck"
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:visibility="gone" />

                </LinearLayout>

                <!-- ============ 更新详情行卡（发现新版本时代码置 VISIBLE） ============ -->
                <LinearLayout
                    android:id="@+id/layoutUpdateCard"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/bg_row_card"
                    android:orientation="vertical"
                    android:padding="14dp"
                    android:visibility="gone">

                    <TextView
                        android:id="@+id/tvNewVersion"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/colorPrimary"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvUpdateDetails"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="7dp"
                        android:lineSpacingExtra="4dp"
                        android:textColor="@color/colorOnSurfaceSoft"
                        android:textSize="14sp" />

                    <ProgressBar
                        android:id="@+id/progressDownload"
                        style="?android:attr/progressBarStyleHorizontal"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:visibility="gone" />

                    <TextView
                        android:id="@+id/tvDownloadProgress"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:textColor="@color/colorOnSurfaceSecondary"
                        android:textSize="12sp"
                        android:visibility="gone" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnUpdate"
                        android:layout_width="match_parent"
                        android:layout_height="46dp"
                        android:layout_marginTop="14dp"
                        android:backgroundTint="@color/colorPrimary"
                        android:text="@string/update_now"
                        android:textColor="@color/colorOnPrimary"
                        android:textStyle="bold"
                        app:cornerRadius="12dp" />

                </LinearLayout>

            </LinearLayout>
        </ScrollView>

        <!-- 关闭：次要动作 → 描边按钮，右对齐（与第二批其他弹框的次操作同款配方） -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/tvClose"
            android:layout_width="160dp"
            android:layout_height="46dp"
            android:layout_gravity="end"
            android:layout_marginTop="16dp"
            android:text="@string/close"
            android:textColor="@color/colorOnSurface"
            app:backgroundTint="@android:color/transparent"
            app:cornerRadius="12dp"
            app:strokeColor="@color/colorOnSurfaceSecondary"
            app:strokeWidth="1dp" />

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
