<?xml version="1.0" encoding="utf-8"?>
<!-- 清理缓存（**横屏 TV · 仪表盘风**）

     与帮助弹框同一套视觉语言：
       · 头部 = 图标徽章（ic_clear_cache）+ 左对齐标题/副标题，右侧缓存大小胶囊；
       · 分隔线；
       · 主体左右分栏：左「缓存项独立行卡列表（可滚动）」，右「取消（描边）/ 清理（橙填充）」竖排按钮栏。

     ⚠️ id 必须与竖屏版完全一致（tvCacheSize / scrollContent / container / btnCancel / btnConfirm），
        否则 ViewBinding 字段会退化成可空类型，且 DialogSizing.limitContentHeight 定位不到滚动区。

     焦点：缓存项行在 layout-land/item_clear_cache.xml 里 focusable + 自绘环 + 可点击勾选
     （与帮助的只读行不同，这里确定键 = 切换勾选），行 nextFocusRight → 取消；
     按钮按左键由几何搜索回落到列表行。scrollContent 自身不再抢焦点。 -->
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:cardBackgroundColor="@color/dialog_background"
    app:cardCornerRadius="24dp"
    app:cardElevation="0dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="26dp"
        android:paddingEnd="26dp"
        android:paddingTop="24dp"
        android:paddingBottom="24dp">

        <!-- ============ 头部：图标徽章 + 标题/副标题 + 缓存大小胶囊 ============ -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/bg_icon_chip"
                android:padding="9dp"
                android:src="@drawable/ic_clear_cache"
                app:tint="@color/colorPrimary" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/clear_cache"
                    android:textColor="@color/colorOnSurface"
                    android:textSize="20sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:text="@string/clear_cache_subtitle"
                    android:textColor="@color/colorOnSurfaceSecondary"
                    android:textSize="12sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvCacheSize"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:background="@drawable/bg_icon_chip"
                android:paddingStart="12dp"
                android:paddingTop="6dp"
                android:paddingEnd="12dp"
                android:paddingBottom="6dp"
                android:text="@string/cache_size_calculating"
                android:textColor="@color/colorPrimary"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="16dp"
            android:background="@color/divider" />

        <!-- ============ 主体：左缓存项列表 + 右按钮栏 ============ -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="horizontal">

            <!-- ============ 左：缓存项列表 ============ -->
            <ScrollView
                android:id="@+id/scrollContent"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:clipToPadding="false"
                android:focusable="false"
                android:overScrollMode="never"
                android:scrollbars="none">

                <LinearLayout
                    android:id="@+id/container"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingBottom="2dp" />

            </ScrollView>

            <!-- ============ 右：按钮栏 ============ -->
            <LinearLayout
                android:layout_width="140dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="20dp"
                android:orientation="vertical">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnCancel"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:text="@string/cancel"
                    android:textColor="@color/colorOnSurface"
                    app:backgroundTint="@android:color/transparent"
                    app:cornerRadius="12dp"
                    app:strokeColor="@color/colorOnSurfaceSecondary"
                    app:strokeWidth="1dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnConfirm"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="12dp"
                    android:backgroundTint="@color/colorPrimary"
                    android:text="@string/clear_action"
                    android:textColor="@color/colorOnPrimary"
                    android:textStyle="bold"
                    app:cornerRadius="12dp" />

            </LinearLayout>

        </LinearLayout>

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
