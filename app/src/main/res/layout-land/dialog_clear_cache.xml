<?xml version="1.0" encoding="utf-8"?>
<!-- 清理缓存（**横屏分栏版**）
     = 竖屏版 layout/dialog_clear_cache.xml 的横屏布局：
       左侧「缓存项列表（可滚动）」，右侧一列竖排按钮（取消 / 清理）。

     ⚠️ id 必须与竖屏版完全一致（tvCacheSize / scrollContent / container / btnCancel / btnConfirm），
        否则 ViewBinding 字段会退化成可空类型。

     焦点：条目行自身 focusable=true（见 layout-land/item_clear_cache.xml）且声明了
     nextFocusRight → 右键到「取消」；按钮按左键由几何搜索回落到列表行。 -->
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:cardBackgroundColor="@color/dialog_background"
    app:cardCornerRadius="24dp"
    app:cardElevation="0dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:paddingTop="22dp"
        android:paddingBottom="22dp">

        <!-- 标题 -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:text="@string/clear_cache"
            android:textColor="@color/colorOnSurface"
            android:textSize="19sp"
            android:textStyle="bold" />

        <!-- 副标题 -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="center"
            android:text="@string/clear_cache_subtitle"
            android:textColor="@color/colorOnSurfaceSecondary"
            android:textSize="13sp" />

        <!-- 缓存大小 -->
        <TextView
            android:id="@+id/tvCacheSize"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="8dp"
            android:text="@string/cache_size_calculating"
            android:textColor="@color/colorPrimary"
            android:textSize="13sp"
            android:textStyle="bold" />

        <!-- 主体：左缓存项列表 + 右按钮栏 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="horizontal">

            <!-- ============ 左：缓存项列表 ============ -->
            <ScrollView
                android:id="@+id/scrollContent"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:focusable="false"
                android:nextFocusRight="@id/btnCancel"
                android:overScrollMode="never"
                android:scrollbars="none">

                <LinearLayout
                    android:id="@+id/container"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_card_rounded"
                    android:orientation="vertical"
                    android:paddingTop="4dp"
                    android:paddingBottom="4dp" />

            </ScrollView>

            <!-- ============ 右：按钮栏 ============ -->
            <LinearLayout
                android:layout_width="132dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="18dp"
                android:orientation="vertical">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnCancel"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:text="@string/cancel"
                    android:backgroundTint="@color/chip_background"
                    android:textColor="@color/colorOnSurface"
                    app:cornerRadius="12dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnConfirm"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:layout_marginTop="10dp"
                    android:text="@string/clear_action"
                    android:backgroundTint="@color/colorPrimary"
                    android:textColor="@color/colorOnPrimary"
                    app:cornerRadius="12dp" />

            </LinearLayout>

        </LinearLayout>

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
