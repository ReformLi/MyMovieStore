<?xml version="1.0" encoding="utf-8"?>
<!-- 帮助页（**横屏 TV · 仪表盘风**）

     与旧版「居中标题 + 大灰块套编号列表」的差别：
       · 左对齐图标徽章标题区 + 分隔线，替代居中两行文字；
       · 7 个功能条目各是一张独立圆角行卡（bg_row_card）：
         功能图标徽章（复用导航图标，主色 tint）+ 标题/描述 + 右侧箭头；
       · 分组头 = 主色小竖条 + 组名，替代孤零零的灰字；
       · 右侧按钮栏：「知道了」升级为主操作橙填充（白环由 TvFocus 自动切换）。

     ⚠️ id 必须与竖屏版完全一致（scrollContent / tvClose）。

     焦点模型：**每一行功能卡都是只读停靠点**（HelpFeatureRow 样式里 focusable +
     自绘焦点环，无点击行为）——方向键逐行移动、获焦行自动滚入可视区，
     方便遥控器上下浏览全部内容。ScrollView 自身刻意 focusable=false：
     逐行焦点已接管滚动，容器再可聚焦只会多出一个「没有可见高亮」的怪停靠点
     （ScrollView 构造时默认 setFocusable(true)，必须显式关掉）。 -->
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:cardBackgroundColor="@color/dialog_background"
    app:cardCornerRadius="24dp"
    app:cardElevation="0dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="26dp"
        android:paddingEnd="26dp"
        android:paddingTop="24dp"
        android:paddingBottom="24dp">

        <!-- ============ 头部：图标徽章 + 左对齐标题/副标题 ============ -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/bg_icon_chip"
                android:padding="9dp"
                android:src="@drawable/ic_help"
                app:tint="@color/colorPrimary" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/help"
                    android:textColor="@color/colorOnSurface"
                    android:textSize="20sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:text="@string/help_welcome"
                    android:textColor="@color/colorOnSurfaceSecondary"
                    android:textSize="12sp" />
            </LinearLayout>
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="16dp"
            android:background="@color/divider" />

        <!-- ============ 主体：左内容区 + 右按钮栏 ============ -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:orientation="horizontal">

            <!-- ============ 左：功能指引（可滚动） ============ -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <ScrollView
                    android:id="@+id/scrollContent"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:clipToPadding="false"
                    android:paddingBottom="4dp"
                    android:focusable="false"
                    android:overScrollMode="never"
                    android:scrollbars="none">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <!-- ===== 分组：核心功能 ===== -->
                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <View
                                android:layout_width="3dp"
                                android:layout_height="12dp"
                                android:background="@color/colorPrimary" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="8dp"
                                android:text="@string/help_group_core"
                                android:textColor="@color/colorOnSurfaceSecondary"
                                android:textSize="12sp"
                                android:textStyle="bold" />
                        </LinearLayout>

                        <!-- 1 首页发现 -->
                        <LinearLayout
                            style="@style/HelpFeatureRow">

                            <ImageView style="@style/HelpFeatureIcon"
                                android:src="@drawable/ic_home" />

                            <LinearLayout style="@style/HelpFeatureText">

                                <TextView
                                    style="@style/HelpFeatureTitle"
                                    android:text="@string/help_home_title" />

                                <TextView
                                    style="@style/HelpFeatureDesc"
                                    android:text="@string/help_home_desc" />
                            </LinearLayout>
                        </LinearLayout>

                        <!-- 2 搜索播放 -->
                        <LinearLayout
                            style="@style/HelpFeatureRow">

                            <ImageView style="@style/HelpFeatureIcon"
                                android:src="@drawable/ic_search" />

                            <LinearLayout style="@style/HelpFeatureText">

                                <TextView
                                    style="@style/HelpFeatureTitle"
                                    android:text="@string/help_search_title" />

                                <TextView
                                    style="@style/HelpFeatureDesc"
                                    android:text="@string/help_search_desc" />
                            </LinearLayout>
                        </LinearLayout>

                        <!-- 3 播放体验 -->
                        <LinearLayout
                            style="@style/HelpFeatureRow">

                            <ImageView style="@style/HelpFeatureIcon"
                                android:src="@drawable/ic_player_play" />

                            <LinearLayout style="@style/HelpFeatureText">

                                <TextView
                                    style="@style/HelpFeatureTitle"
                                    android:text="@string/help_player_title" />

                                <TextView
                                    style="@style/HelpFeatureDesc"
                                    android:text="@string/help_player_desc" />
                            </LinearLayout>
                        </LinearLayout>

                        <!-- ===== 分组：更多功能 ===== -->
                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="18dp"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <View
                                android:layout_width="3dp"
                                android:layout_height="12dp"
                                android:background="@color/colorPrimary" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="8dp"
                                android:text="@string/help_group_more"
                                android:textColor="@color/colorOnSurfaceSecondary"
                                android:textSize="12sp"
                                android:textStyle="bold" />
                        </LinearLayout>

                        <!-- 4 离线下载 -->
                        <LinearLayout
                            style="@style/HelpFeatureRow">

                            <ImageView style="@style/HelpFeatureIcon"
                                android:src="@drawable/ic_download" />

                            <LinearLayout style="@style/HelpFeatureText">

                                <TextView
                                    style="@style/HelpFeatureTitle"
                                    android:text="@string/help_download_title" />

                                <TextView
                                    style="@style/HelpFeatureDesc"
                                    android:text="@string/help_download_desc" />
                            </LinearLayout>
                        </LinearLayout>

                        <!-- 5 弹幕观看 -->
                        <LinearLayout
                            style="@style/HelpFeatureRow">

                            <ImageView style="@style/HelpFeatureIcon"
                                android:src="@drawable/ic_danmu" />

                            <LinearLayout style="@style/HelpFeatureText">

                                <TextView
                                    style="@style/HelpFeatureTitle"
                                    android:text="@string/help_danmaku_title" />

                                <TextView
                                    style="@style/HelpFeatureDesc"
                                    android:text="@string/help_danmaku_desc" />
                            </LinearLayout>
                        </LinearLayout>

                        <!-- 6 播放历史 -->
                        <LinearLayout
                            style="@style/HelpFeatureRow">

                            <ImageView style="@style/HelpFeatureIcon"
                                android:src="@drawable/ic_history" />

                            <LinearLayout style="@style/HelpFeatureText">

                                <TextView
                                    style="@style/HelpFeatureTitle"
                                    android:text="@string/help_history_title" />

                                <TextView
                                    style="@style/HelpFeatureDesc"
                                    android:text="@string/help_history_desc" />
                            </LinearLayout>
                        </LinearLayout>

                        <!-- 7 视频源管理 -->
                        <LinearLayout
                            style="@style/HelpFeatureRow">

                            <ImageView style="@style/HelpFeatureIcon"
                                android:src="@drawable/ic_source" />

                            <LinearLayout style="@style/HelpFeatureText">

                                <TextView
                                    style="@style/HelpFeatureTitle"
                                    android:text="@string/video_source" />

                                <TextView
                                    style="@style/HelpFeatureDesc"
                                    android:text="@string/help_source_desc" />
                            </LinearLayout>
                        </LinearLayout>

                    </LinearLayout>
                </ScrollView>

                <!-- 底部提示 -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:text="@string/help_footer"
                    android:textColor="@color/colorOnSurfaceDisabled"
                    android:textSize="12sp" />

            </LinearLayout>

            <!-- ============ 右：按钮栏 ============ -->
            <LinearLayout
                android:layout_width="140dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="20dp"
                android:orientation="vertical">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/tvClose"
                    android:layout_width="match_parent"
                    android:layout_height="46dp"
                    android:backgroundTint="@color/colorPrimary"
                    android:text="@string/got_it"
                    android:textColor="@color/colorOnPrimary"
                    android:textStyle="bold"
                    app:cornerRadius="12dp" />

            </LinearLayout>

        </LinearLayout>

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
