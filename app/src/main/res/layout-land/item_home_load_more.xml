<?xml version="1.0" encoding="utf-8"?>
<!-- ⚠️ 本目录同时服务**手机横屏**：勿写 focusable / focusableInTouchMode / 焦点环 foreground ——
     电视端的可聚焦与焦点环由 TvFocus.applyTo 以代码赋予（入口带 isActive 门控）；
     XML 里写死会让触屏第一次点击只取焦点、不触发点击（按钮要点两下）。 -->
<TextView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/tvLoadMore"
    android:layout_width="match_parent"
    android:layout_height="48dp"
    android:layout_marginStart="14dp"
    android:layout_marginTop="10dp"
    android:layout_marginEnd="14dp"
    android:layout_marginBottom="14dp"
    android:background="@drawable/bg_episode_normal"
    android:gravity="center"
    android:text="加载更多"
    android:textColor="@color/text_primary"
    android:textSize="14sp"
    android:textStyle="bold" />
