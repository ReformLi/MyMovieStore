<?xml version="1.0" encoding="utf-8"?>
<!-- ⚠️ 本目录同时服务**手机横屏**：勿写 focusable / focusableInTouchMode / 焦点环 foreground ——
     电视端的可聚焦与焦点环由 TvFocus.applyTo 以代码赋予（入口带 isActive 门控）；
     XML 里写死会让触屏第一次点击只取焦点、不触发点击（按钮要点两下）。 -->
<!-- 清理缓存条目行（**横屏 TV · 仪表盘风**）：独立圆角行卡。
     id 与竖屏版一致（ivIcon / tvTitle / tvDesc / ivCheck），勾选态由代码切换 ivCheck 图源。
     可点击行：获焦橙环（foreground）+ 按压涟漪（背景层），确定键 = 切换勾选。 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="8dp"
    android:background="@drawable/bg_row_card_ripple"
    android:gravity="center_vertical"
    android:nextFocusRight="@id/btnCancel"
    android:orientation="horizontal"
    android:paddingStart="12dp"
    android:paddingTop="10dp"
    android:paddingEnd="14dp"
    android:paddingBottom="10dp">

    <ImageView
        android:id="@+id/ivIcon"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:background="@drawable/bg_icon_chip"
        android:padding="9dp"
        android:scaleType="fitCenter"
        android:src="@drawable/ic_player_search"
        app:tint="@color/colorPrimary" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/clear_search_cache"
            android:textColor="@color/colorOnSurface"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvDesc"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="@string/clear_search_cache_desc"
            android:textColor="@color/colorOnSurfaceSecondary"
            android:textSize="12sp" />
    </LinearLayout>

    <ImageView
        android:id="@+id/ivCheck"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_marginStart="8dp"
        android:src="@drawable/ic_check_circle"
        app:tint="@color/colorPrimary" />

</LinearLayout>
