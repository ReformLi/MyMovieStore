<?xml version="1.0" encoding="utf-8"?>
<!-- ⚠️ 本目录同时服务**手机横屏**：`focusableInTouchMode="true"` 会让触屏第一次点击只取焦点、
     不触发点击（按钮要点两下）。故：凡「电视端已由 TvFocus.applyTo 以代码接管」的按钮，这里
     一律不写聚焦属性；翻页按钮例外 —— 它电视端只靠 XML 提供 focusable + 焦点环（代码里自行
     设置了 onFocusChangeListener，再补 applyTo 会顶掉该监听），故保留 focusable 与 foreground，
     只去掉 focusableInTouchMode。 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:clipChildren="false"
    android:orientation="vertical">

    <!-- 横屏可用高度有限（电视 1080p 约 372dp），顶部操作条做紧凑处理，把高度让给网格 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/surface_background"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingTop="8dp"
        android:paddingEnd="12dp"
        android:paddingBottom="8dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="播放历史"
                android:textColor="@color/text_primary"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="继续观看上次播放的内容"
                android:textColor="@color/text_secondary"
                android:textSize="11sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvClear"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:background="@drawable/bg_episode_normal"
            android:gravity="center"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:text="@string/clear_history"
            android:textColor="@color/colorAccent"
            android:textSize="13sp" />
    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipChildren="false">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recyclerView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:padding="4dp" />

        <TextView
            android:id="@+id/tvEmpty"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:padding="24dp"
            android:text="@string/empty_history"
            android:textColor="@color/text_secondary"
            android:textSize="16sp"
            android:visibility="gone" />
    </FrameLayout>
</LinearLayout>
