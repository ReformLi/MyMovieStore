<?xml version="1.0" encoding="utf-8"?>
<!-- ⚠️ 本目录同时服务**手机横屏**：勿写 focusable / focusableInTouchMode / 焦点环 foreground ——
     电视端的可聚焦与焦点环由 TvFocus.applyTo 以代码赋予（入口带 isActive 门控）；
     XML 里写死会让触屏第一次点击只取焦点、不触发点击（按钮要点两下）。 -->
<!-- 视频源管理：单条源（**横屏 TV · 仪表盘风**）：独立圆角行卡 + 自定义勾选圆，整行可点击。
     id 与竖屏版一致（tvSourceName / tvCheck）；勾选态由代码 setBackgroundResource 切换。 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="8dp"
    android:background="@drawable/bg_row_card_ripple"
    android:gravity="center_vertical"
    android:nextFocusRight="@id/btnCancel"
    android:orientation="horizontal"
    android:paddingStart="14dp"
    android:paddingTop="12dp"
    android:paddingEnd="12dp"
    android:paddingBottom="12dp">

    <TextView
        android:id="@+id/tvSourceName"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:textColor="@color/colorOnSurface"
        android:textSize="14sp" />

    <!-- 自定义勾选圆：选中 = 主色实心 + ✓；未选中 = 描边圆环，状态由代码切换 -->
    <TextView
        android:id="@+id/tvCheck"
        android:layout_width="22dp"
        android:layout_height="22dp"
        android:background="@drawable/bg_check_unselected"
        android:gravity="center"
        android:text="✓"
        android:textColor="@color/colorOnPrimary"
        android:textSize="12sp"
        android:textStyle="bold" />

</LinearLayout>
