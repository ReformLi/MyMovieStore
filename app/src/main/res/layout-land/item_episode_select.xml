<?xml version="1.0" encoding="utf-8"?>
<!-- 选择下载集数：单条集数（**横屏 TV · 仪表盘风**）：独立圆角行卡 + 自定义勾选圆，整行可点击。
     id 与竖屏版一致（tvEpisodeName / tvCheck）；已添加项由代码置灰、禁用点击与焦点。 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="8dp"
    android:background="@drawable/bg_row_card_ripple"
    android:defaultFocusHighlightEnabled="false"
    android:focusable="true"
    android:focusableInTouchMode="true"
    android:foreground="@drawable/bg_tv_focus_ring"
    android:gravity="center_vertical"
    android:nextFocusRight="@id/btnCancel"
    android:orientation="horizontal"
    android:paddingStart="14dp"
    android:paddingTop="12dp"
    android:paddingEnd="12dp"
    android:paddingBottom="12dp">

    <TextView
        android:id="@+id/tvEpisodeName"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:textColor="@color/colorOnSurface"
        android:textSize="14sp" />

    <!-- 自定义勾选圆：选中 = 主色实心 + ✓；未选中 = 描边圆环，状态由代码切换 -->
    <TextView
        android:id="@+id/tvCheck"
        android:layout_width="22dp"
        android:layout_height="22dp"
        android:background="@drawable/bg_check_unselected"
        android:gravity="center"
        android:text="✓"
        android:textColor="@color/colorOnPrimary"
        android:textSize="12sp"
        android:textStyle="bold" />

</LinearLayout>
