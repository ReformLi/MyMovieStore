<?xml version="1.0" encoding="utf-8"?>
<!-- 通用确认弹窗（**横屏 TV · 仪表盘风**）
     居中窄卡不分栏（正文短、无列表），但头部升级为「图标徽章 + 左对齐标题」，
     正文左对齐，按钮改为「取消（描边）/ 主操作（橙填充）」，与其余 TV 弹框同一套语言。

     ⚠️ 本弹框走 **ViewBinding**（DialogConfirmBinding）：竖屏暴露的
        tvConfirmTitle / tvConfirmMessage / btnCancel / btnConfirm 必须**同名齐全**，
        否则字段退化为可空、ConfirmDialog.kt 编译不过。
        主按钮文案由代码 setText(positiveText)（删除场景传「删除」），XML 里只是占位。 -->
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:cardBackgroundColor="@color/dialog_background"
    app:cardCornerRadius="24dp"
    app:cardElevation="0dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="26dp"
        android:paddingEnd="26dp"
        android:paddingTop="24dp"
        android:paddingBottom="24dp">

        <!-- 头部：图标徽章 + 左对齐标题 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="@drawable/bg_icon_chip"
                android:padding="8dp"
                android:src="@drawable/ic_about"
                app:tint="@color/colorPrimary" />

            <TextView
                android:id="@+id/tvConfirmTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="@string/tips"
                android:textColor="@color/colorOnSurface"
                android:textSize="19sp"
                android:textStyle="bold" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="14dp"
            android:background="@color/divider" />

        <!-- 正文（辅助说明），无正文时整段隐藏（代码 GONE） -->
        <TextView
            android:id="@+id/tvConfirmMessage"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:lineSpacingExtra="3dp"
            android:textColor="@color/colorOnSurfaceSoft"
            android:textSize="14sp" />

        <!-- 按钮行：次操作描边 + 主操作橙填充，等分并排 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnCancel"
                android:layout_width="0dp"
                android:layout_height="46dp"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:text="@string/cancel"
                android:textColor="@color/colorOnSurface"
                app:backgroundTint="@android:color/transparent"
                app:cornerRadius="12dp"
                app:strokeColor="@color/colorOnSurfaceSecondary"
                app:strokeWidth="1dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnConfirm"
                android:layout_width="0dp"
                android:layout_height="46dp"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:backgroundTint="@color/colorPrimary"
                android:text="@string/confirm_ok"
                android:textColor="@color/colorOnPrimary"
                android:textStyle="bold"
                app:cornerRadius="12dp" />

        </LinearLayout>

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
