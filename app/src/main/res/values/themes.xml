<resources xmlns:tools="http://schemas.android.com/tools">

    <!-- 主题公共项：深浅色共用，状态栏图标明暗由 values / values-night 各自的 Base.Theme.MyMovieStore 决定 -->
    <style name="ThemeMyMovieStoreCore" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- 主色 -->
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorPrimaryVariant">@color/colorPrimaryDark</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorSecondary">@color/colorAccent</item>
        <item name="colorOnSecondary">@color/white</item>

        <!-- 背景与表面 -->
        <item name="android:windowBackground">@color/colorBackground</item>
        <item name="colorSurface">@color/colorSurface</item>
        <item name="colorOnSurface">@color/colorOnSurface</item>

        <!-- 文字 -->
        <item name="android:textColorPrimary">@color/colorOnSurface</item>
        <item name="android:textColorSecondary">@color/colorOnSurfaceSecondary</item>

        <!-- 错误色 -->
        <item name="colorError">@color/colorError</item>
        <item name="colorOnError">@color/white</item>

        <!-- 状态栏与导航栏 -->
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@color/colorSurface</item>

        <!-- 底部导航栏 -->
        <item name="colorControlHighlight">@color/colorSurfaceHighlight</item>
    </style>

    <!-- 全局主题（浅色）：状态栏图标为深色；深色模式见 values-night/themes.xml -->
    <style name="Base.Theme.MyMovieStore" parent="ThemeMyMovieStoreCore">
        <item name="android:windowLightStatusBar">true</item>
    </style>

    <style name="Theme.MyMovieStore" parent="Base.Theme.MyMovieStore" />

    <!-- 统一圆角弹框样式（12dp 圆角，背景色跟随日夜切换） -->
    <style name="RoundedDialog" parent="Theme.Material3.DayNight.Dialog.Alert">
        <item name="android:windowBackground">@drawable/bg_dialog_rounded</item>
    </style>

    <!-- 居中卡片弹窗通用样式（UI 规范 5.3.1）：窗口背景透明，圆角/背景由内部 MaterialCardView 承担 -->
    <style name="CardDialog" parent="RoundedDialog">
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowMinWidthMajor">75%</item>
        <item name="android:windowMinWidthMinor">75%</item>
    </style>

    <!-- 清理缓存弹框（沿用通用卡片弹窗样式） -->
    <style name="ClearCacheDialog" parent="CardDialog" />
</resources>
