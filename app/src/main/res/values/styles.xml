<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Cloudflare 人工验证兜底窗口：不透明暗色背景（半透明 Activity 内 WebView 有白屏/表面合成问题）。
         parent 走 App 自己的 Material3 体系（原先挂 Theme.AppCompat.NoActionBar，
         不继承 colorPrimary / colorControlHighlight / DayNight —— 与播放页同属 W3）。 -->
    <style name="Theme.MyMovieStore.Challenge" parent="Base.Theme.MyMovieStore">
        <item name="android:windowBackground">#B3000000</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:backgroundDimEnabled">false</item>
    </style>

    <!-- ======================== 文本样式 ======================== -->

    <!-- H1 大标题 22sp -->
    <style name="TextAppearance.MyMovieStore.H1" parent="TextAppearance.Material3.HeadlineSmall">
        <item name="android:textSize">22sp</item>
        <item name="android:textColor">@color/colorOnSurface</item>
        <item name="android:textStyle">bold</item>
    </style>

    <!-- H2 中标题 18sp -->
    <style name="TextAppearance.MyMovieStore.H2" parent="TextAppearance.Material3.TitleMedium">
        <item name="android:textSize">18sp</item>
        <item name="android:textColor">@color/colorOnSurface</item>
        <item name="android:textStyle">bold</item>
    </style>

    <!-- H3 小标题 16sp -->
    <style name="TextAppearance.MyMovieStore.H3" parent="TextAppearance.Material3.TitleSmall">
        <item name="android:textSize">16sp</item>
        <item name="android:textColor">@color/colorOnSurface</item>
        <item name="android:textStyle">bold</item>
    </style>

    <!-- Body 正文 14sp -->
    <style name="TextAppearance.MyMovieStore.Body" parent="TextAppearance.Material3.BodyMedium">
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">@color/colorOnSurfaceSecondary</item>
    </style>

    <!-- Caption 辅助文字 12sp -->
    <style name="TextAppearance.MyMovieStore.Caption" parent="TextAppearance.Material3.BodySmall">
        <item name="android:textSize">12sp</item>
        <item name="android:textColor">@color/colorOnSurfaceSecondary</item>
    </style>

    <!-- ======================== 按钮样式 ======================== -->

    <!-- 主按钮 -->
    <style name="Widget.MyMovieStore.Button.Primary" parent="Widget.Material3.Button">
        <item name="backgroundTint">@color/colorPrimary</item>
        <item name="android:textColor">@color/white</item>
        <item name="cornerRadius">4dp</item>
        <item name="android:minHeight">44dp</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <!-- 次要按钮 -->
    <style name="Widget.MyMovieStore.Button.Secondary" parent="Widget.Material3.Button.OutlinedButton">
        <item name="strokeColor">@color/colorBorder</item>
        <item name="android:textColor">@color/colorOnSurface</item>
        <item name="cornerRadius">4dp</item>
        <item name="android:minHeight">44dp</item>
    </style>

    <!-- 文本按钮 -->
    <style name="Widget.MyMovieStore.Button.Text" parent="Widget.Material3.Button.TextButton">
        <item name="android:textColor">@color/colorPrimary</item>
    </style>

    <!-- ======================== Toolbar 样式 ======================== -->
    <style name="Widget.MyMovieStore.Toolbar" parent="Widget.Material3.Toolbar">
        <item name="android:background">@color/colorSurface</item>
        <item name="titleTextColor">@color/colorOnSurface</item>
        <item name="navigationIconTint">@color/colorOnSurface</item>
    </style>

    <!-- ======================== 卡片样式 ======================== -->
    <style name="Widget.MyMovieStore.CardView" parent="Widget.Material3.CardView.Elevated">
        <item name="cardBackgroundColor">@color/colorSurface</item>
        <item name="cardCornerRadius">8dp</item>
        <item name="cardElevation">2dp</item>
    </style>

    <!-- ======================== 底部导航样式 ======================== -->
    <style name="BottomNavText" parent="TextAppearance.Material3.LabelSmall">
        <item name="android:textSize">10sp</item>
    </style>

    <!-- ======================== TV 弹框条目样式（仪表盘风） ======================== -->

    <!-- 帮助功能条目：整行圆角卡（图标徽章 + 标题/描述），独立抬起一层。
         **只读停靠点**：focusable + 焦点环让遥控器能逐行停靠（获焦自动滚入可视区），
         但不设 clickable、代码不绑任何点击行为 —— 按确定键无动作。
         defaultFocusHighlightEnabled=false（API26+）：关掉系统默认高亮，只用自绘环；
         低版本设备忽略该属性，安全。 -->
    <style name="HelpFeatureRow">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:orientation">horizontal</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:background">@drawable/bg_row_card</item>
        <item name="android:layout_marginTop">8dp</item>
        <item name="android:paddingStart">12dp</item>
        <item name="android:paddingEnd">14dp</item>
        <item name="android:paddingTop">10dp</item>
        <item name="android:paddingBottom">10dp</item>
    </style>

    <!-- 条目左侧功能图标：圆角橙底徽章 + 主色 tint -->
    <style name="HelpFeatureIcon">
        <item name="android:layout_width">36dp</item>
        <item name="android:layout_height">36dp</item>
        <item name="android:background">@drawable/bg_icon_chip</item>
        <item name="android:padding">9dp</item>
        <item name="android:tint">@color/colorPrimary</item>
        <item name="android:scaleType">fitCenter</item>
    </style>

    <!-- 条目文字块：标题 + 描述纵向排布 -->
    <style name="HelpFeatureText">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:layout_marginStart">12dp</item>
        <item name="android:orientation">vertical</item>
    </style>

    <style name="HelpFeatureTitle">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">@color/colorOnSurface</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="HelpFeatureDesc">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">2dp</item>
        <item name="android:textColor">@color/colorOnSurfaceSecondary</item>
        <item name="android:textSize">12sp</item>
    </style>
</resources>
