<?xml version="1.0" encoding="utf-8"?>
<!-- 关于页：居中卡片风格（与更新提示弹窗统一），内容超长时可滚动 -->
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:cardBackgroundColor="@color/dialog_background"
    app:cardCornerRadius="24dp"
    app:cardElevation="0dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="22dp"
        android:paddingEnd="22dp"
        android:paddingTop="22dp"
        android:paddingBottom="16dp">

        <!-- 标题 -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:text="@string/about"
            android:textColor="@color/colorOnSurface"
            android:textSize="19sp"
            android:textStyle="bold" />

        <!-- App 名称 -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="14dp"
            android:text="@string/app_name"
            android:textColor="@color/colorOnSurface"
            android:textSize="17sp" />

        <!-- 版本徽章 -->
        <TextView
            android:id="@+id/tvVersion"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="6dp"
            android:background="@drawable/bg_badge"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:paddingTop="4dp"
            android:paddingBottom="4dp"
            android:textColor="@color/colorPrimary"
            android:textSize="13sp"
            android:textStyle="bold" />

        <!-- 简介 -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center"
            android:text="@string/about_description"
            android:textColor="@color/colorOnSurfaceSecondary"
            android:textSize="13sp"
            android:lineSpacingExtra="4dp" />

        <!-- 分隔线 -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="18dp"
            android:layout_marginBottom="12dp"
            android:background="@color/chip_background" />

        <!-- 内容区（更新信息，超长可滚动） -->
        <ScrollView
            android:id="@+id/scrollContent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:overScrollMode="never">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <!-- 检查更新入口 -->
                <LinearLayout
                    android:id="@+id/layoutCheckUpdate"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:background="@drawable/bg_card_rounded"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp"
                    android:paddingTop="13dp"
                    android:paddingBottom="13dp">

                    <ImageView
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:contentDescription="@string/check_update"
                        android:src="@android:drawable/ic_menu_rotate" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/tvUpdateTitle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/check_update"
                            android:textColor="@color/colorOnSurface"
                            android:textSize="15sp" />

                        <TextView
                            android:id="@+id/tvUpdateStatus"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="@string/check_update_hint"
                            android:textColor="@color/colorOnSurfaceSecondary"
                            android:textSize="12sp" />

                    </LinearLayout>

                    <ProgressBar
                        android:id="@+id/progressCheck"
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:visibility="gone" />

                </LinearLayout>

                <!-- 更新详情卡片（发现新版本时显示） -->
                <LinearLayout
                    android:id="@+id/layoutUpdateCard"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginTop="10dp"
                    android:padding="14dp"
                    android:background="@drawable/bg_card_rounded"
                    android:visibility="gone">

                    <TextView
                        android:id="@+id/tvNewVersion"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/colorPrimary"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvUpdateDetails"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="7dp"
                        android:textColor="@color/colorOnSurfaceSoft"
                        android:textSize="14sp"
                        android:lineSpacingExtra="4dp" />

                    <ProgressBar
                        android:id="@+id/progressDownload"
                        style="?android:attr/progressBarStyleHorizontal"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:visibility="gone" />

                    <TextView
                        android:id="@+id/tvDownloadProgress"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:textColor="@color/colorOnSurfaceSecondary"
                        android:textSize="12sp"
                        android:visibility="gone" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnUpdate"
                        android:layout_width="match_parent"
                        android:layout_height="46dp"
                        android:layout_marginTop="14dp"
                        android:text="@string/update_now"
                        android:textColor="@color/colorOnPrimary"
                        android:backgroundTint="@color/colorPrimary"
                        app:cornerRadius="12dp" />

                </LinearLayout>

            </LinearLayout>
        </ScrollView>

        <!-- 关闭：与其它弹窗的次要按钮（取消）完全同款 —— MaterialButton + chip_background 底。

             ⚠️ 不要再用「TextView + bg_card_rounded + android:foreground="?attr/selectableItemBackground"」这套写法：
             ?attr/selectableItemBackground 在本 App 主题下解析成 AppCompat 的 **Holo 遗留选择器**
             （abc_item_background_holo_dark），这个 drawable **自带焦点态与按压态高亮**：
                 获焦   → #33B5E5 @60% 蓝
                 按压   → #40CCCCCC（25% 白，视觉上就是「背景刷白」）
             它作为 foreground 会盖在按钮自身底色之上，于是「一聚焦 / 一按下确定键，按钮背景就变白」，
             还会和 TvFocus 自绘的橙环抢戏（系统默认焦点高亮已被 TvFocus 关掉，我们又补了自绘环）。
             MaterialButton 自带 ripple，触屏端的按压反馈不会丢。 -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/tvClose"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginTop="14dp"
            android:backgroundTint="@color/chip_background"
            android:text="@string/close"
            android:textColor="@color/colorOnSurface"
            android:textSize="14sp"
            app:cornerRadius="12dp" />

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
