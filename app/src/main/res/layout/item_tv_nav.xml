<?xml version="1.0" encoding="utf-8"?>
<!--
  电视端顶部导航页签 —— 精致紧凑版
  图标 20dp + 文字 13sp，底部细指示条，视觉轻量。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="wrap_content"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center_horizontal"
    android:paddingStart="24dp"
    android:paddingEnd="24dp"
    android:clipToPadding="false"
    android:background="@android:color/transparent">

    <!-- 图标 + 文字水平居中 -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/ivNavIcon"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:scaleType="fitCenter"
            android:layout_marginEnd="8dp"
            app:tint="@color/colorOnSurfaceSecondary" />

        <TextView
            android:id="@+id/tvNavLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="13sp"
            android:includeFontPadding="false"
            android:textColor="@color/colorOnSurfaceSecondary" />
    </LinearLayout>

    <!-- 底部指示条：选中时显示品牌橙色细条 -->
    <View
        android:id="@+id/navIndicator"
        android:layout_width="24dp"
        android:layout_height="2dp"
        android:layout_gravity="center_horizontal"
        android:background="@drawable/bg_tv_nav_indicator"
        android:visibility="invisible" />

</LinearLayout>
