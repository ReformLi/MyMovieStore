<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- 应用内更新：安装下载的 APK（Android 8.0+ 需用户授予「安装未知应用」权限） -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <!--
      Android TV 适配（required=false：不排除手机/平板，同一 APK 双形态运行）
      - leanback：声明支持电视形态
      - touchscreen：声明不依赖触摸屏（电视无触摸输入）
    -->
    <uses-feature
        android:name="android.software.leanback"
        android:required="false" />
    <uses-feature
        android:name="android.hardware.touchscreen"
        android:required="false" />

    <application
        android:name=".MovieApplication"
        android:usesCleartextTraffic="true"
        android:allowBackup="true"
        android:banner="@drawable/tv_banner"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.MyMovieStore"
        tools:targetApi="31">
        <activity
            android:name=".presentation.activity.MainActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|keyboardHidden">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
                <!-- 电视启动器入口 -->
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity>
        <activity
            android:name=".presentation.activity.DetailActivity"
            android:exported="false"
            android:parentActivityName=".presentation.activity.MainActivity"
            android:screenOrientation="landscape" />
        <activity
            android:name=".presentation.activity.PlayerActivity"
            android:exported="false"
            android:parentActivityName=".presentation.activity.DetailActivity"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden"
            android:screenOrientation="landscape"
            android:supportsPictureInPicture="true"
            android:theme="@style/Theme.AppCompat.NoActionBar" />
        <activity
            android:name=".presentation.activity.HistoryActivity"
            android:exported="false"
            android:parentActivityName=".presentation.activity.MainActivity"
            android:screenOrientation="landscape" />
        <activity
            android:name=".presentation.activity.DownloadActivity"
            android:exported="false"
            android:parentActivityName=".presentation.activity.MainActivity"
            android:screenOrientation="landscape" />
        <!-- Cloudflare 人工验证兜底窗口（自动过盾失败时弹出，透明浮层） -->
        <activity
            android:name=".presentation.challenge.CloudflareChallengeActivity"
            android:exported="false"
            android:screenOrientation="landscape"
            android:theme="@style/Theme.MyMovieStore.Challenge" />
        <service
            android:name=".data.download.DownloadService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <!-- FileProvider：向系统安装器共享 cacheDir 下的更新 APK -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>
</manifest>
